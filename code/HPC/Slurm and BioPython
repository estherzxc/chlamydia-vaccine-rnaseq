# Output file
output_file="Combine_R1.fastq.gz"

# Create or clear the output file
> "$output\_file"

# Loop through all .fastq.gz files
for file in *.fastq.gz; do
    # Decompress each input file and append to the gzipped output
    zcat "$file" >> Combine_R1.fastq
done

# Compress the combined file
gzip -c Combine_R1.fastq > "$output_file"

# Remove the uncompressed temporary file
rm Combine_R1.fastq

