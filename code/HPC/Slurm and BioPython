import gzip
import os
import time
from Bio import SeqIO
from itertools import islice

# Define the folder containing the input FASTQ.gz files
input_folder = "/work/users/c/o/cookesf/Chlamydia_Data/08-22-24_Chlamydia_Mouse_Samples/R1_UMIs/"
# Define the folder where the modified FASTQ.gz files will be saved
output_folder = "/work/users/c/o/cookesf/Chlamydia_Data/08-22-24_Chlamydia_Mouse_Samples/R1_Modified"
# Define the path to the file containing the filenames and strings of bases
config_file = "/work/users/c/o/cookesf/Chlamydia_Data/Python_Files/Sample_Prefix_File.txt"

# Number of FASTQ records to process at a time (125 records = 500 lines)
records_per_chunk = 1250000

# Ensure the output folder exists
os.makedirs(output_folder, exist_ok=True)

# Read the configuration file to get the filenames and strings of bases
with open(config_file, "r") as config:
    config_data = dict(line.strip().split(',') for line in config)

# Iterate over each file in the specified folder
for filename in os.listdir(input_folder):
    if filename.endswith(".fastq.gz"):
        # Construct the full path to the input FASTQ file
        input_fastq = os.path.join(input_folder, filename)
 
        # Check if the filename is in the config data
        if filename in config_data:
            string_to_add = config_data[filename]
 
            # Define the output file name with the output folder
            output_fastq = os.path.join(output_folder, filename.replace(".fastq.gz", "_modified.fastq.gz"))

            # Start time measurement
            start_time = time.time()

            # Open the input and output FASTQ.gz files using gzip
            with gzip.open(input_fastq, "rt") as infile, gzip.open(output_fastq, "wt") as outfile:
                # Create an iterator to parse the FASTQ records in chunks
                records_iterator = SeqIO.parse(infile, "fastq")
 
                while True:
                    # Fetch the next chunk of records
                    chunk = list(islice(records_iterator, records_per_chunk))
 
                    # Break the loop if no more records are left to process
                    if not chunk:
                        break
 
                    # Modify each record in the chunk
                    for record in chunk:
                        # Clear per-letter annotations
                        record.letter_annotations.clear()
                        # Prepend the string to the sequence
                        record.seq = string_to_add + record.seq
                        # Replace the quality scores with 'K' for the length of the modified sequence
                        record.letter_annotations["phred_quality"] = [ord('K') - 33] * len(record.seq)

                    # Write the modified chunk to the output file
                    SeqIO.write(chunk, outfile, "fastq")

            # End time measurement and calculate the duration
            end_time = time.time()
            duration = end_time - start_time
 
            # Print a report for the processed file
            print(f"Finished processing {filename}")
            print(f"Time taken: {duration:.2f} seconds")


